{
  "name": "board-agnostic",
  "version": "0.1.0",
  "description": "A lightweight, TypeScript-first hardware abstraction layer for JavaScript and Node.js.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qalvinahmad/board-agnostic.git"
  },
  "bugs": {
    "url": "https://github.com/qalvinahmad/board-agnostic/issues"
  },
  "homepage": "https://github.com/qalvinahmad/board-agnostic#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
